{
  "name": "work-assistant",
  "productName": "工作台助手",
  "version": "1.0.0",
  "description": "工作台助手 — 离线桌面工作管理与提醒应用",
  "author": "工作台助手",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:db": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs db-tests.js",
    "test:dashboard": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs dashboard-tests.js",
    "test:calendar": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs calendar-tests.js",
    "test:meeting": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs meeting-tests.js",
    "test:contacts": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs contacts-tests.js",
    "test:reminder": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs reminder-tests.js",
    "test:timeline": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs timeline-tests.js",
    "test:ui-scale": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs ui-scale-tests.js",
    "test:files": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs files-tests.js",
    "test:summary": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs summary-tests.js",
    "test:stats": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs work-stats-tests.js",
    "test:enhance": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs enhance-tests.js",
    "demo:seed": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs seed-demo.js",
    "start": "node scripts/run.mjs electron-vite preview",
    "dist": "npm run build && node scripts/run.mjs electron-builder --win nsis --x64",
    "dist:dir": "npm run build && node scripts/run.mjs electron-builder --win dir --x64"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "element-plus": "^2.14.7",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
