{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-tests",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/main/db/**/*",
    "src/main/files/extract.ts",
    "src/main/reminders/**/*",
    "src/main/series/**/*",
    "src/shared/**/*",
    "src/renderer/src/utils/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "src/main/reminders/engine.ts",
    "src/renderer/src/utils/meeting-display.ts"
  ]
}
